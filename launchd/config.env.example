# Copy to config.env and edit paths, then run: ./scripts/install-launchd.sh

# RuSKK binary (cargo build --release 後のパス)
RUSKK_BIN="$HOME/Developer/RuSKK/target/release/ruskk"

# yaskkserv2
YASKKSERV2_BIN="/path/to/yaskkserv2"
YASKKSERV2_DICTIONARY="$HOME/Documents/SKK/dictionary.yaskkserv2"

# Optional: log directory (default: ~/Library/Logs/ruskk)
# LOG_DIR="$HOME/Library/Logs/ruskk"

# azooKey SKKServ は GUI アプリで自動起動するため、ここでは設定不要です。
# RuSKK は起動時に :1180 の待機のみ行います。

# Optional: macSKK user dictionary path for auto-import (毎時間インポート)
# 空にするとインポートの定期実行は登録されません。
MACSKK_USER_DICT_PATH="$HOME/Library/Containers/net.mtgto.inputmethod.macSKK/Data/Documents/Dictionaries/skk-jisyo.utf8"
