# Copy to config.env and edit paths, then run: ./scripts/install-launchd.sh

# skk-proxy binary (cargo build --release 後のパス)
SKK_PROXY_BIN="$HOME/Developer/skk-proxy/target/release/skk-proxy"

# yaskkserv2
YASKKSERV2_BIN="/path/to/yaskkserv2"
YASKKSERV2_DICTIONARY="$HOME/Documents/SKK/dictionary.yaskkserv2"

# Optional: log directory (default: ~/Library/Logs/skk-proxy)
# LOG_DIR="$HOME/Library/Logs/skk-proxy"

# azooKey SKKServ は GUI アプリで自動起動するため、ここでは設定不要です。
# skk-proxy は起動時に :1180 の待機のみ行います。
