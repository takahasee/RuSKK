# Copy to config.env and edit paths, then run: ./scripts/install-launchd.sh

# RuSKKserv binary (cargo build --release 後のパス)
RUSKKSERV_BIN="$HOME/Developer/RuSKKserv/target/release/ruskkserv"

# yaskkserv2
YASKKSERV2_BIN="/path/to/yaskkserv2"
YASKKSERV2_DICTIONARY="$HOME/Documents/SKK/dictionary.yaskkserv2"
# yaskkserv2 の Google 日本語入力連携 (disable [デフォルト] | notfound | last | first)
# デフォルトの yaskkserv2-first 構成では、ローカル辞書に無い連文節・未登録語を
# azoo-key-skkserv へフォールバックさせるため disable を推奨します。
# YASKKSERV2_GOOGLE_JAPANESE_INPUT="disable"
# Optional: Google 日本語入力有効時（notfound/last/first）の永続キャッシュ (default: ~/Library/Caches/ruskkserv/yaskkserv2-google.cache)
# YASKKSERV2_GOOGLE_CACHE="$HOME/Library/Caches/ruskkserv/yaskkserv2-google.cache"

# Optional: log directory (default: ~/Library/Logs/ruskkserv)
# LOG_DIR="$HOME/Library/Logs/ruskkserv"

# Optional: log level (default: info; デバッグ時のみ ruskkserv=debug,info や ruskkserv=trace,info を指定)
# RUSKKSERV_LOG_LEVEL="info"

# azooKey SKKServ は GUI アプリで自動起動するため、ここでは設定不要です。
# RuSKKserv は起動時に :1180 (azooKey) および :1179 (yaskkserv2) の待機を行います。

# Optional: macSKK user dictionary path for auto-import (毎時間インポート)
# ※ 推奨構成（変換履歴保存OFF）では定期インポートは不要です。空（またはコメントアウト）にしておくと定期実行は登録されません。
# MACSKK_USER_DICT_PATH="$HOME/Library/Containers/net.mtgto.inputmethod.macSKK/Data/Documents/Dictionaries/skk-jisyo.utf8"

# 送りあり見出し（例: かk, きr）の活用形復元・語幹抽出機能 (1: 有効 [デフォルト], 0: 無効)
# 元に戻したい場合はここを 0 にして ./scripts/install-launchd.sh install を実行してください。
RUSKKSERV_OKURI_EXPANSION=1

# 直前確定単語に基づく文脈連動候補昇格（肉→切る、服→着る、木→伐る） (1: 有効 [デフォルト], 0: 無効)
# 元に戻したい場合はここを 0 にして ./scripts/install-launchd.sh install を実行してください。
RUSKKSERV_CONTEXT_RANKING=1
# システム辞書（大辞林等）掲載語および SKK 注釈付き単語の優先昇格機能 (1: 有効 [デフォルト], 0: 無効)
# 元に戻したい場合はここを 0 にして ./scripts/install-launchd.sh install を実行してください。
RUSKKSERV_ANNOTATION_PRIORITY=1

# バックエンド参照順 (yaskkserv2-first: yaskkserv2 先 [デフォルト], azookey-first: azooKey 先 [従来順])
# 従来の azooKey 優先へ戻したい場合は azookey-first にして ./scripts/install-launchd.sh install を実行してください。
RUSKKSERV_BACKEND_ORDER="yaskkserv2-first"

# yaskkserv2 との通信エンコーディング (euc [デフォルト] | utf8 | euc-req-utf8-resp)
# 絵文字や JIS 第 2 水準・異体字の &#x 化および文字化けを完全に解消したい場合は、
# yaskkserv2_make_dictionary --utf8 で辞書を作成した上で "utf8" を指定してください
# （"utf8" 指定時は LaunchAgent が自動で yaskkserv2 へ --midashi-utf8 を付与して起動します）。
# RUSKKSERV_YASKKSERV2_ENCODING="utf8"
